---
import BaseLayout from '../layouts/BaseLayout.astro';
export const prerender = true;
---
<BaseLayout title="Batalhas de Rima | Histórias que permanecem" description="Um arquivo vivo da cultura freestyle brasileira: artistas, batalhas, conquistas e música.">
  <main id="conteudo" class="min-h-screen">
    <header class="mx-auto flex max-w-7xl items-center justify-between px-6 py-6">
      <a href="/" class="font-black tracking-tight" aria-label="Batalhas de Rima, início">BATALHAS<span class="text-[var(--signal)]">.</span>DE RIMA</a>
      <nav aria-label="Navegação principal" class="hidden gap-6 text-sm text-[var(--muted)] md:flex">
        <a href="/artistas">Artistas</a><a href="/batalhas">Batalhas</a><a href="/historias">Histórias</a>
      </nav>
    </header>
    <section class="relative mx-auto flex min-h-[78svh] max-w-7xl flex-col justify-end overflow-hidden px-6 pb-16 pt-24">
      <div aria-hidden="true" class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_75%_35%,rgba(231,71,60,.22),transparent_45%)]"></div>
      <p class="relative mb-5 text-xs font-bold uppercase tracking-[.3em] text-[var(--signal)]">Arquivo vivo da cultura freestyle</p>
      <h1 class="relative max-w-5xl text-6xl font-black uppercase leading-[.88] tracking-[-.06em] sm:text-8xl lg:text-[10rem]">A cultura<br/>não termina<br/><span class="text-[var(--signal)]">no round.</span></h1>
      <p class="relative mt-8 max-w-xl text-lg text-[var(--muted)]">Histórias que nascem no improviso. Legados que permanecem.</p>
      <div class="relative mt-10 flex flex-wrap gap-4">
        <a class="rounded-full bg-[var(--signal)] px-6 py-3 text-sm font-bold text-white transition hover:bg-white hover:text-black" href="/artistas">Explorar artistas</a>
        <a class="rounded-full border border-white/25 px-6 py-3 text-sm font-bold hover:border-white" href="/historias">Conhecer a cultura</a>
      </div>
    </section>
    <section class="mx-auto max-w-7xl px-6 pb-24">
      <p class="text-xs font-bold uppercase tracking-[.25em] text-[var(--signal)]">Primeiro capítulo</p>
      <h2 class="mt-3 text-4xl font-black uppercase tracking-tight sm:text-6xl">Uma história em construção.</h2>
      <p class="mt-4 max-w-2xl text-[var(--muted)]">Estamos preparando o primeiro perfil documental da plataforma. Em breve, a trajetória de Jotapê ganha um espaço à altura de sua história.</p>
    </section>
  </main>
</BaseLayout>
